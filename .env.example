# --- Database ---------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
# postgresql+psycopg:// prefix. Session pooler (5432) or transaction pooler (6543) both work.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Slack ------------------------------------------------------------------
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEST_CHANNEL_ID=C0123456789
# Where approval requests are posted (defaults to the test channel)
SLACK_APPROVAL_CHANNEL_ID=
# Only needed if token rotation is enabled on the Slack app
SLACK_REFRESH_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- AI (local Ollama server) ------------------------------------------------
# Host: http://localhost:11434 . In docker-compose, use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Behaviour ----------------------------------------------------------------
HTTP_MAX_ATTEMPTS=4
LLM_VALIDATION_ATTEMPTS=2
CREATE_NOISE_APPROVALS=false
# true = create tables on startup (local dev only; use sql/schema.sql for Supabase)
AUTO_CREATE_TABLES=false
